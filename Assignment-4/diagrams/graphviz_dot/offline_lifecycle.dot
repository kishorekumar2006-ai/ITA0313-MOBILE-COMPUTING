digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.32", ranksep="0.42", labelloc="t", label="Offline record lifecycle and protection", fontsize=18, fontname="Arial"];
node [shape=box, style="rounded", color="black", fontcolor="black", fontname="Arial", fontsize=12, margin="0.16,0.10"];
edge [color="black", fontcolor="black", fontname="Arial", fontsize=10, arrowsize=0.7];
capture [label="Capture record"];
validate [label="Validate required fields"];
id [label="Assign UUID / sequence / timestamp"];
encrypt [label="Encrypt payload before local write"];
queue [label="Persist to encrypted queue"];
retry [label="Network available?"];
upload [label="TLS batch upload with idempotency key"];
ack [label="Server validates and returns ACK"];
done [label="Mark synced / retain audit"];
wait [label="Wait with exponential backoff"];
capture -> validate;
validate -> id [label="valid"];
id -> encrypt;
encrypt -> queue [label="AEAD"];
queue -> retry [label="worker trigger"];
retry -> upload [label="yes"];
retry -> wait [label="no"];
wait -> retry [label="retry"];
upload -> ack;
ack -> done [label="valid ACK"];
}