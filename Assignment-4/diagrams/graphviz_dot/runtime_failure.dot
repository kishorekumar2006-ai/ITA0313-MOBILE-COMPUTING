digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.32", ranksep="0.42", labelloc="t", label="Runtime leak and ANR failure-detection flow", fontsize=18, fontname="Arial"];
node [shape=box, style="rounded", color="black", fontcolor="black", fontname="Arial", fontsize=12, margin="0.16,0.10"];
edge [color="black", fontcolor="black", fontname="Arial", fontsize=10, arrowsize=0.7];
bug [label="Static Activity reference / unbounded cache"];
retain [label="Objects remain strongly reachable"];
heap [label="Heap grows across iterations"];
gc [label="GC runs repeatedly / pause rises"];
main [label="Main thread blocked by synchronous work"];
watchdog [label="Input dispatch timeout / watchdog"];
anr [label="ANR risk / failure report"];
fix [label="Weak reference / bounded cache / executor"];
bug -> retain [label="retention"];
retain -> heap [label="allocation accumulates"];
heap -> gc [label="allocation pressure"];
gc -> main [label="pause plus blocked work"];
main -> watchdog [label="no input response"];
watchdog -> anr [label="timeout"];
anr -> fix [label="root-cause remediation"];
}